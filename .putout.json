{
    "match": {
        ".madrun.*": {
            "madrun/insert-test-dts": "on"
        },
        "webpack.config.js": {
            "convert-webpack-to-rspack": "on"
        },
        "client": {
            "nodejs/convert-commonjs-to-esm/common": "off",
            "nodejs": "off"
        },
        "client/dword.js": {
            "remove-console": "off"
        }
    },
    "ignore": [
        "codemirror",
        "modules"
    ],
    "plugins": [
        "convert-webpack-to-rspack"
    ]
}
